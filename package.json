{
  "name": "tilchi",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @tilchi/web --filter @tilchi/api dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "test": "pnpm -r --if-present test",
    "contrast": "node scripts/check-contrast.mjs",
    "routes": "pnpm --filter @tilchi/web routes"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "typescript": "5.9.3"
  }
}
