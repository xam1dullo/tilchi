{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["apps/**", "packages/**", "scripts/**", "docs/**", "*.json"],
    "ignoreUnknown": true
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2 },
  "linter": { "enabled": true, "rules": { "recommended": true } },
  "javascript": {
    "parser": { "unsafeParameterDecoratorsEnabled": true },
    "formatter": { "semicolons": "asNeeded", "quoteStyle": "single" }
  },
  "assist": { "actions": { "source": { "organizeImports": "off" } } },
  "overrides": [
    {
      "includes": ["apps/api/**"],
      "linter": { "rules": { "style": { "useImportType": "off" } } }
    },
    {
      "includes": ["apps/web/src/routeTree.gen.ts"],
      "linter": { "rules": { "suspicious": { "noExplicitAny": "off" } } }
    }
  ]
}
