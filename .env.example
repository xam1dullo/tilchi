# Copy to .env for local compose. Never commit .env.
# Production secrets live only in /etc/tilchi.env on the VPS (ADR 0010).

NODE_ENV=development
TZ=Asia/Tashkent

# Required by docker-compose.yml (prod shape). Dev override may fill defaults.
POSTGRES_USER=tilchi
POSTGRES_PASSWORD=tilchi
POSTGRES_DB=tilchi
DATABASE_URL=postgres://tilchi:tilchi@postgres:5432/tilchi
REDIS_URL=redis://redis:6379

# Local placeholders. Do not put a real bot token in git.
# Production replaces both in /etc/tilchi.env. The webhook secret must be
# 32-256 chars of [A-Za-z0-9_-] or production refuses to boot.
TELEGRAM_BOT_TOKEN=dev-bot-token
TELEGRAM_BOT_USERNAME=tilchiuz_bot
TELEGRAM_WEBHOOK_SECRET=dev-webhook-secret-not-for-production
# Comma-separated Telegram user ids. Empty means every user is a learner.
TELEGRAM_TEACHER_ALLOWLIST=
TELEGRAM_ADMIN_ALLOWLIST=
# Bot Mini App menu button (https only; empty = no button) and the chats that
# get one alert per completed registration (comma list; ADMIN_CHAT_ID = legacy single).
PUBLIC_APP_URL=
ADMIN_CHAT_IDS=
ADMIN_CHAT_ID=

SESSION_COOKIE_NAME=__Host-tilchi_sid
SESSION_TTL_DAYS=30
SESSION_CACHE_TTL_SECONDS=300
HANDOFF_TTL_SECONDS=300

# Local LiveKit dev pair. Production refuses to boot with these values.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
# Browser-facing signaling URL, always through nginx /rtc.
LIVEKIT_PUBLIC_URL=ws://localhost/rtc

TURN_USER=tilchi
TURN_PASSWORD=dev-turn-password

# Learner audio in MinIO on the compose network (ADR 0011). Dev values below;
# production refuses them: set non-dev S3_ACCESS_KEY / S3_SECRET_KEY (>= 16 chars)
# in /etc/tilchi.env. S3_PUBLIC_URL is the origin browsers PUT/GET presigned
# URLs on (host root, no path; https in production); the API itself reaches
# MinIO at S3_ENDPOINT. The bucket is created on API boot.
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=http://localhost:9000
S3_BUCKET=tilchi-audio
S3_ACCESS_KEY=tilchi-dev
S3_SECRET_KEY=tilchi-dev-secret
# S3_REGION=us-east-1
# S3_CORS_ORIGIN=http://localhost   # origin allowed to upload from the browser

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local/dev only. Honored only when NODE_ENV is development or test.
# Production Nest refuses to start if either is set. Production nginx clears
# X-Tilchi-Preview-Role.
# TILCHI_DEMO=1 seeds one teacher, one learner, one group, and one lesson on API boot.
TILCHI_DEMO=
# Preview role for /app over HTTP (learner|teacher|admin). Query ?preview= overrides it.
TILCHI_PREVIEW_ROLE=

# --- Production only (/etc/tilchi.env), read by docker-compose.prod.yml ---
# TILCHI_SHA=            image tag = git SHA; set by scripts/vps-deploy.sh
# TILCHI_DOMAIN=         public host name, also the TLS cert name
# LIVEKIT_NODE_IP=       public IPv4 of the VPS
# REDIS_PASSWORD=        REDIS_URL must then be redis://:<password>@redis:6379
