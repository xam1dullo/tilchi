# Copy to .env for local compose. Never commit .env.
# Production secrets live only in /etc/tilchi.env on the VPS.

NODE_ENV=development
TZ=Asia/Tashkent

POSTGRES_USER=tilchi
POSTGRES_PASSWORD=tilchi
POSTGRES_DB=tilchi
DATABASE_URL=postgres://tilchi:tilchi@postgres:5432/tilchi
REDIS_URL=redis://redis:6379

# Placeholder name only. Do not put a real bot token in git.
TELEGRAM_BOT_TOKEN=
# Required in production before /bot/webhook will accept updates: at least 32
# characters from A-Z a-z 0-9 _ -, and the same value you give Telegram as
# secret_token. `openssl rand -hex 32` makes one.
TELEGRAM_WEBHOOK_SECRET=
# Public handle of the bot that confirms sign-ins. Empty means the production bot.
TELEGRAM_BOT_USERNAME=tilchiuz_bot
# Comma-separated Telegram user ids. Everyone else signs in as a learner, and a
# change applies at the next sign-in.
TELEGRAM_ADMIN_ALLOWLIST=
TELEGRAM_TEACHER_ALLOWLIST=

# Not read yet: sessions and handoffs stay in memory until the Redis store lands (ADR 0002).
SESSION_COOKIE_NAME=__Host-tilchi_sid
SESSION_TTL_DAYS=30
SESSION_CACHE_TTL_SECONDS=300
HANDOFF_TTL_SECONDS=300

# Required by compose (no defaults). Nest refuses this dev pair in production:
# set a new key and a 32+ char secret in /etc/tilchi.env.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-local-only-not-for-the-vps
# Site origin; the LiveKit client appends /rtc, which nginx routes to LiveKit.
LIVEKIT_URL=ws://localhost

# Required by compose (no defaults).
TURN_USER=tilchi
TURN_PASSWORD=dev-turn-password

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local only. Ignored when NODE_ENV=production. Shows the /app empty state.
TILCHI_PREVIEW_ROLE=
